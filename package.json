{
  "name": "legiongo2companion",
  "version": "2.4.0",
  "description": "All-in-one Legion Go 2 hardware controls for Decky Loader",
  "license": "BSD-3-Clause",
  "type": "module",
  "scripts": {
    "build": "rollup -c && node scripts/check-build.mjs && node scripts/desktop-contract.mjs && node scripts/check-desktop-build.mjs",
    "watch": "rollup -c -w",
    "typecheck": "tsc --noEmit",
    "test:backend": "python -W error -m unittest discover -s tests -p \"test_*.py\"",
    "test:frontend": "node --test \"tests/*.test.cjs\"",
    "package": "node scripts/check-desktop-build.mjs --runtime && node scripts/package.mjs && python scripts/verify-package.py && python scripts/check-legacy-updaters.py",
    "check": "npm run typecheck && npm run test:backend && npm run test:frontend && npm run build && npm run package"
  },
  "devDependencies": {
    "@decky/api": "^1.1.3",
    "@decky/ui": "^4.12.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/react": "^19.1.1",
    "@types/react-dom": "^19.1.1",
    "rollup": "^4.0.0",
    "rollup-plugin-external-globals": "^0.13.0",
    "tslib": "^2.8.1",
    "typescript": "^5.0.0"
  },
  "decky": {
    "files": [
      "*.py",
      "pyudev",
      "desktop",
      "dist",
      "plugin.json",
      "package.json",
      "package-lock.json",
      "rollup.config.js",
      "tsconfig.json",
      "src",
      "scripts/check-build.mjs",
      "scripts/check-desktop-build.mjs",
      "scripts/desktop-contract.mjs",
      "scripts/build-native.py",
      "scripts/verify-package.py",
      "scripts/package.mjs",
      "README.md",
      "CHANGELOG.md",
      "SOURCE.md",
      "docs/DESKTOP_UI.md",
      "docs/CONTROLLER_FIRMWARE.md",
      "docs/LOGGING.md",
      "LICENSE",
      "LICENSE.MIT",
      "LICENSE.HUESYNC",
      "LICENSE.DECKY-ROLLUP",
      "NOTICE"
    ],
    "forbidden": [
      "(^|/)(tests|artifacts|build|bin|\\.local-validation)(/|$)",
      "_live\\.py$"
    ],
    "folder": "LegionGo2Companion",
    "keepDist": [
      "desktop"
    ],
    "python": [
      "3.14"
    ],
    "flags": [
      "root"
    ]
  }
}
